# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).

# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/seo_engine"

# ── AI (the agents) ──────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── SEO market data (pay-as-you-go) ──────────────────────
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# ── Google (Search Console + GA4) OAuth ──────────────────
# One OAuth client; per-business tokens are stored in the Connector table.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/connectors/google/callback"

# ── Google Maps (local data for geo pages) ───────────────
GOOGLE_MAPS_API_KEY=""

# ── Web content extraction (competitor research) ─────────
FIRECRAWL_API_KEY=""

# ── Auth (dashboard logins) ──────────────────────────────
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Background jobs / scheduling ─────────────────────────
# Using Inngest (host-agnostic; dodges serverless timeouts)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Secrets encryption ───────────────────────────────────
# 32-byte key (base64) used to encrypt Connector.configEnc at rest.
CONNECTOR_ENCRYPTION_KEY=""

# NOTE: Shopify/WordPress/Webflow credentials are NOT global env vars —
# they're entered per-business during onboarding and stored encrypted in the DB.

# ── Dev only ─────────────────────────────────────────────
# Enables POST /api/dev/pipeline (drive an idea through the whole lifecycle).
# Auto-on outside production; set to "1" to also allow it in a production build.
ENABLE_DEV_ROUTES=""

# OFFLINE MODE: with no ANTHROPIC_API_KEY / connector keys, every agent falls
# back to clearly-labeled placeholder output, so the full pipeline
# (idea → brief → draft → grade → publish) runs end-to-end with zero credentials.
# Add the real keys above to swap in real research, writing, and grading.
